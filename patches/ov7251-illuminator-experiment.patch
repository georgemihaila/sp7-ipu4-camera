+static int ov7251_update_strobe_bit(struct ov7251 *ov7251, u16 reg,
+					    u8 mask, bool enable, const char *name)
+{
+	u8 before;
+	u8 after;
+	u8 verify;
+	int ret;
+
+	ret = ov7251_read_reg(ov7251, reg, &before);
+	if (ret) {
+		dev_err(ov7251->dev,
+			"IRTRACE strobe %s read-before failed reg=0x%04x ret=%d\n",
+			name, reg, ret);
+		return ret;
+	}
+
+	after = enable ? before | mask : before & ~mask;
+	ret = ov7251_write_reg(ov7251, reg, after);
+	if (ret) {
+		dev_err(ov7251->dev,
+			"IRTRACE strobe %s write failed reg=0x%04x value=0x%02x ret=%d\n",
+			name, reg, after, ret);
+		return ret;
+	}
+
+	ret = ov7251_read_reg(ov7251, reg, &verify);
+	if (ret) {
+		dev_err(ov7251->dev,
+			"IRTRACE strobe %s readback failed reg=0x%04x ret=%d\n",
+			name, reg, ret);
+		return ret;
+	}
+
+	if ((verify & mask) != (after & mask)) {
+		dev_err(ov7251->dev,
+			"IRTRACE strobe %s enable mismatch reg=0x%04x "
+			"before=0x%02x requested=0x%02x readback=0x%02x\n",
+			name, reg, before, after, verify);
+		return -EIO;
+	}
+
+	if ((verify ^ before) & (u8)~mask) {
+		dev_err(ov7251->dev,
+			"IRTRACE strobe %s preserved-bit mismatch reg=0x%04x "
+			"before=0x%02x requested=0x%02x readback=0x%02x\n",
+			name, reg, before, after, verify);
+		return -EIO;
+	}
+
+	if (strobe_diagnostics)
+		dev_info(ov7251->dev,
+			 "IRTRACE strobe %s reg=0x%04x before=0x%02x "
+			 "after=0x%02x readback=0x%02x\n",
+			 name, reg, before, after, verify);
+
+	return 0;
+}
