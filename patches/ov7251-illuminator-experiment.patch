+static void ov7251_trace_strobe_state(struct ov7251 *ov7251,
+					      const char *phase)
+{
+	unsigned int i;
+
+	if (!strobe_diagnostics)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(ov7251_strobe_diag_regs); i++) {
+		u8 value = 0;
+		int ret;
+
+		ret = ov7251_read_reg(ov7251, ov7251_strobe_diag_regs[i], &value);
+		if (ret)
+			dev_info(ov7251->dev,
+				 "IRTRACE strobe-state phase=%s reg=0x%04x value=invalid ret=%d\n",
+				 phase, ov7251_strobe_diag_regs[i], ret);
+		else
+			dev_info(ov7251->dev,
+				 "IRTRACE strobe-state phase=%s reg=0x%04x value=0x%02x\n",
+				 phase, ov7251_strobe_diag_regs[i], value);
+	}
+}
+
+static void ov7251_record_strobe_cleanup_error(struct ov7251 *ov7251,
+						const char *phase, int ret)
+{
+	if (!ret)
+		return;
+
+	if (!ov7251->strobe_cleanup_error)
+		ov7251->strobe_cleanup_error = ret;
+	ov7251->strobe_recovery_required = true;
+	dev_err(ov7251->dev,
+		"IRTRACE strobe cleanup fault phase=%s current=%d first=%d "
+		"pending=%d recovery-required=1\n",
+		phase, ret, ov7251->strobe_cleanup_error,
+		ov7251->strobe_cleanup_needed);
+}
+
+static int ov7251_ir_illuminator_off(struct ov7251 *ov7251)
+{
+	int first_ret = 0;
+	int ret;
+
+	if (!ov7251->power_on) {
+		dev_err(ov7251->dev,
+			"IRTRACE strobe cleanup refused while sensor is unpowered\n");
+		return -EHOSTDOWN;
+	}
+
+	/* Remove the output gate before removing the frame-PWM permission. */
+	ret = ov7251_update_strobe_bit(ov7251, OV7251_STROBE_OUTPUT_CONTROL,
+					       OV7251_STROBE_OUTPUT_ENABLE, false,
+					       "output-disable");
+	if (ret && !first_ret)
+		first_ret = ret;
+
+	ret = ov7251_update_strobe_bit(ov7251,
+					       OV7251_STROBE_FRAME_PWM_CONTROL,
+					       OV7251_STROBE_FRAME_PWM_ENABLE, false,
+					       "pwm-disable");
+	if (ret && !first_ret)
+		first_ret = ret;
+
+	if (!first_ret)
+		ov7251->strobe_cleanup_needed = false;
+
+	return first_ret;
+}
+
+static int ov7251_ir_illuminator_on(struct ov7251 *ov7251)
+{
+	int ret;
+
+	if (!ov7251->power_on) {
+		dev_err(ov7251->dev,
+			"IRTRACE strobe enable refused while sensor is unpowered\n");
+		return -EHOSTDOWN;
+	}
+
+	if (ov7251->strobe_cleanup_needed ||
+	    ov7251->strobe_recovery_required) {
+		dev_err(ov7251->dev,
+			"IRTRACE strobe enable refused pending=%d recovery-required=%d "
+			"first-cleanup-error=%d\n",
+			ov7251->strobe_cleanup_needed,
+			ov7251->strobe_recovery_required,
+			ov7251->strobe_cleanup_error);
+		return -EIO;
+	}
+
+	/* Keep the flag set until both fields have been proven disabled again. */
+	ov7251->strobe_cleanup_needed = true;
+
+	/* Permit frame PWM first; expose the sensor STROBE output last. */
+	ret = ov7251_update_strobe_bit(ov7251,
+					       OV7251_STROBE_FRAME_PWM_CONTROL,
+					       OV7251_STROBE_FRAME_PWM_ENABLE, true,
+					       "pwm-enable");
+	if (ret)
+		return ret;
+
+	return ov7251_update_strobe_bit(ov7251, OV7251_STROBE_OUTPUT_CONTROL,
+					       OV7251_STROBE_OUTPUT_ENABLE, true,
+					       "output-enable");
+}
